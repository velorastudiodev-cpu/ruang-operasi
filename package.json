    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tanstack/react-query": "^5.90.0",
    "argon2": "^0.44.0",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.0",
    "lucide-react": "^0.577.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-is": "^19.2.0",
    "recharts": "^3.5.0",
